  "stable_identifiers": {
    "input_id": "SHA-256 of canonical intersection_id + 12 volumes + four phase greens",
    "sample_id": "I{intersection:02d}- + SHA-256 of canonical input and four targets",
    "record_sha256": "SHA-256 of the original JSONL line excluding CR/LF"
  },
  "derived_features": {
    "saturation_flow_vph": 1800.0,
    "cycle_time": "sum(active phase green seconds) + intersection cycle_offset",
    "flow_ratio": "movement volume / saturation_flow_vph",
    "effective_green_ratio": "sum(green_phase / cycle_time) over all phases controlling a movement",
    "degree_of_saturation": "x = flow_ratio / effective_green_ratio = (q/s)/(g/C)",
    "multiple_controlling_phases": "their green ratios are summed, matching the active lane context"
  },
